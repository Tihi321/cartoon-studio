{
  "name": "cartoon-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Cartoon Studio: makes a series of cutout-puppet cartoons for children, in Croatian and English",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build:player": "vite build --config vite.player.config.ts --logLevel warn",
    "build:engine": "yarn build:player && vite build --config vite.engine.config.ts --logLevel warn",
    "dev": "yarn build:engine && electron-vite dev",
    "build": "yarn build:engine && electron-vite build",
    "dist": "yarn build && electron-builder --win --x64 --config electron-builder.config.cjs && node scripts/verify-package.mjs",
    "dist:installer": "yarn build && electron-builder --win nsis --x64 --config electron-builder.config.cjs && node scripts/verify-package.mjs",
    "dist:portable": "yarn build && electron-builder --win portable --x64 --config electron-builder.config.cjs && node scripts/verify-package.mjs",
    "dist:dir": "yarn build && electron-builder --win --dir --x64 --config electron-builder.config.cjs",
    "verify:package": "node scripts/verify-package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "engine": "yarn build:engine && node out/engine/index.js",
    "mcp": "yarn build:engine && node out/engine/index.js --mcp-only",
    "key:set": "yarn build:engine && node out/engine/index.js key-set",
    "studio:shots": "node scripts/studio-shots.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "yarn test && yarn test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.player.json",
    "lint": "eslint .",
    "docs:check": "tsx scripts/check-contracts-doc.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "chokidar": "^4.0.3",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "author": "Tihomir Selak"
}
