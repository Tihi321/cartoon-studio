{
  "schema": "cts.acting-library/1",
  "note": "The single source for action names. The engine reads it for lint (E_ACTION_UNKNOWN, E_ACTION_BODY, W_GESTURE_OVER_LINE), the writer prompt and the timeline; the Python registry in this folder must list the same names (test B2). kind: gesture | locomotion | react | camera. seconds: the shortest, the usual and the longest time one run takes (the timeline never stretches a gesture past max; inside a long line the speaker fills the time with accents). overLine: may run while the actor speaks. needsTarget: the script beat must give a target (cast id, prop id or mark). auto: made by the assembler, not written in a script. bodies (HUB-31): the body kinds that can do it (creature, vehicle); vehicleTypes: only a car or only a train. A move style that is no action of its own runs one: `tiptoe` is a slow `walk` (0.6 of the walk speed: `WALK_KIND` in src/engine/anim/timeline3d.ts, `moveAction` in src/engine/blender/library.ts). A name shared by both bodies is one action whose parts are the union of what each body moves (an actor keys only the controls it has). In parts, wheel_* is every wheel control, antenna* every antenna link, lamp_glow the glow of the lamp eyes, camera the camera. The creature arm and leg actions are frozen for pilot 3 (no new features).",
  "actions": [
    { "name": "idle", "kind": "gesture", "auto": true, "bodies": ["creature"], "parts": ["root", "body", "head", "arm_L", "arm_R"], "seconds": { "min": 1, "default": 4, "max": 30 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "idle_engine", "kind": "gesture", "auto": true, "bodies": ["vehicle"], "parts": ["squash", "body", "head", "chimney", "exhaust", "antenna*"], "seconds": { "min": 1, "default": 4, "max": 30 }, "overLine": true, "needsTarget": false, "params": { "shiver": true } },
    { "name": "blink", "kind": "gesture", "auto": true, "bodies": ["creature", "vehicle"], "parts": ["lid_L", "lid_R"], "seconds": { "min": 0.12, "default": 0.16, "max": 0.3 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "look_at", "kind": "gesture", "bodies": ["creature", "vehicle"], "parts": ["pupil_L", "pupil_R", "head", "body"], "seconds": { "min": 0.2, "default": 0.5, "max": 2 }, "overLine": true, "needsTarget": true, "params": { "bodyPastDeg": 60 } },

    { "name": "walk", "kind": "locomotion", "bodies": ["creature"], "parts": ["root", "body", "leg_L", "leg_R", "arm_L", "arm_R", "head"], "seconds": { "min": 0.5, "default": 3, "max": 12 }, "overLine": false, "needsTarget": true, "params": { "style": "walk" } },
    { "name": "hop", "kind": "locomotion", "bodies": ["creature"], "parts": ["root", "squash", "body", "head", "ear_L1", "ear_R1"], "seconds": { "min": 0.4, "default": 2, "max": 10 }, "overLine": false, "needsTarget": true, "params": { "style": "hop" } },
    { "name": "run", "kind": "locomotion", "bodies": ["creature"], "parts": ["root", "body", "leg_L", "leg_R", "arm_L", "arm_R", "head"], "seconds": { "min": 0.4, "default": 2, "max": 8 }, "overLine": false, "needsTarget": true, "params": { "style": "run" } },
    { "name": "turn", "kind": "locomotion", "bodies": ["creature", "vehicle"], "vehicleTypes": ["car"], "parts": ["root", "squash", "body", "head", "wheel_*"], "seconds": { "min": 0.25, "default": 0.5, "max": 1.5 }, "overLine": true, "needsTarget": false, "params": { "facing": "left|right" } },
    { "name": "drive", "kind": "locomotion", "bodies": ["vehicle"], "vehicleTypes": ["car"], "parts": ["root", "squash", "body", "head", "wheel_*", "antenna*"], "seconds": { "min": 0.8, "default": 3, "max": 12 }, "overLine": true, "needsTarget": true, "params": { "style": "drive" } },
    { "name": "zoom", "kind": "locomotion", "bodies": ["vehicle"], "vehicleTypes": ["car"], "parts": ["root", "squash", "body", "head", "wheel_*", "antenna*", "exhaust"], "seconds": { "min": 0.4, "default": 1.2, "max": 4 }, "overLine": false, "needsTarget": true, "params": { "style": "zoom" } },
    { "name": "reverse", "kind": "locomotion", "bodies": ["vehicle"], "vehicleTypes": ["car"], "parts": ["root", "squash", "body", "head", "wheel_*", "antenna*"], "seconds": { "min": 0.6, "default": 2, "max": 6 }, "overLine": true, "needsTarget": true, "params": { "style": "reverse" } },
    { "name": "chug", "kind": "locomotion", "bodies": ["vehicle"], "vehicleTypes": ["train"], "parts": ["root", "squash", "body", "head", "wheel_*", "chimney"], "seconds": { "min": 1, "default": 4, "max": 15 }, "overLine": true, "needsTarget": true, "params": { "style": "chug", "puffEveryM": 1.5 } },

    { "name": "point", "kind": "gesture", "bodies": ["creature"], "parts": ["arm_R", "hand_R", "body", "head"], "seconds": { "min": 0.8, "default": 1.4, "max": 3 }, "overLine": true, "needsTarget": true, "params": { "arm": "L|R" } },
    { "name": "wave", "kind": "gesture", "bodies": ["creature"], "parts": ["arm_R", "hand_R", "head"], "seconds": { "min": 0.8, "default": 1.6, "max": 3 }, "overLine": true, "needsTarget": false, "params": { "arm": "L|R" } },
    { "name": "nod", "kind": "gesture", "bodies": ["creature", "vehicle"], "parts": ["head", "body", "squash"], "seconds": { "min": 0.4, "default": 0.8, "max": 1.6 }, "overLine": true, "needsTarget": false, "params": { "count": 2 } },
    { "name": "shake_head", "kind": "gesture", "bodies": ["creature", "vehicle"], "parts": ["head", "body"], "seconds": { "min": 0.5, "default": 1, "max": 2 }, "overLine": true, "needsTarget": false, "params": { "count": 2 } },
    { "name": "shrug", "kind": "gesture", "bodies": ["creature"], "parts": ["body", "head", "arm_L", "arm_R"], "seconds": { "min": 0.6, "default": 1, "max": 2 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "think", "kind": "gesture", "bodies": ["creature"], "parts": ["arm_R", "hand_R", "head", "brow_L", "brow_R"], "seconds": { "min": 1, "default": 2, "max": 5 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "sit", "kind": "gesture", "bodies": ["creature"], "parts": ["root", "body", "leg_L", "leg_R", "arm_L", "arm_R", "head"], "seconds": { "min": 0.8, "default": 1.2, "max": 2.5 }, "overLine": false, "needsTarget": true, "params": {} },
    { "name": "stand_up", "kind": "gesture", "bodies": ["creature"], "parts": ["root", "body", "leg_L", "leg_R", "arm_L", "arm_R", "head"], "seconds": { "min": 0.7, "default": 1, "max": 2.5 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "cheer", "kind": "gesture", "bodies": ["creature"], "parts": ["arm_L", "arm_R", "body", "head", "squash"], "seconds": { "min": 0.8, "default": 1.6, "max": 3 }, "overLine": false, "needsTarget": false, "params": {} },

    { "name": "bounce", "kind": "gesture", "bodies": ["vehicle"], "parts": ["root", "squash", "body", "head", "wheel_*", "antenna*"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": true, "needsTarget": false, "params": { "count": 2 } },
    { "name": "lean", "kind": "gesture", "bodies": ["vehicle"], "parts": ["squash", "body", "head", "antenna*"], "seconds": { "min": 0.5, "default": 1, "max": 2.5 }, "overLine": true, "needsTarget": true, "params": {} },
    { "name": "tilt", "kind": "gesture", "bodies": ["vehicle"], "parts": ["body", "head", "brow_L", "brow_R", "lid_L", "lid_R"], "seconds": { "min": 0.8, "default": 1.6, "max": 4 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "wiggle", "kind": "gesture", "bodies": ["vehicle"], "parts": ["squash", "body", "head", "antenna*"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "rev", "kind": "gesture", "bodies": ["vehicle"], "parts": ["squash", "body", "head", "wheel_*", "exhaust", "chimney"], "seconds": { "min": 0.5, "default": 1, "max": 2 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "honk", "kind": "gesture", "bodies": ["vehicle"], "vehicleTypes": ["car"], "parts": ["squash", "body", "head", "horn", "lid_L", "lid_R", "lamp_glow"], "seconds": { "min": 0.5, "default": 0.8, "max": 1.5 }, "overLine": false, "needsTarget": false, "params": { "sfx": "horn" } },
    { "name": "whistle", "kind": "gesture", "bodies": ["vehicle"], "vehicleTypes": ["train"], "parts": ["squash", "body", "head", "chimney", "lid_L", "lid_R"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": false, "needsTarget": false, "params": { "sfx": "whistle" } },
    { "name": "puff", "kind": "gesture", "bodies": ["vehicle"], "parts": ["chimney", "exhaust", "squash"], "seconds": { "min": 0.3, "default": 0.8, "max": 2 }, "overLine": true, "needsTarget": false, "params": { "count": 1 } },
    { "name": "flash", "kind": "gesture", "bodies": ["vehicle"], "parts": ["lamp_glow", "lid_L", "lid_R"], "seconds": { "min": 0.2, "default": 0.5, "max": 1.2 }, "overLine": true, "needsTarget": false, "params": { "count": 2 } },
    { "name": "wink", "kind": "gesture", "bodies": ["vehicle"], "parts": ["lid_L", "lid_R", "head"], "seconds": { "min": 0.3, "default": 0.5, "max": 1 }, "overLine": true, "needsTarget": false, "params": { "side": "L|R" } },
    { "name": "point_nose", "kind": "gesture", "bodies": ["vehicle"], "parts": ["root", "squash", "body", "head", "lamp_glow"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": true, "needsTarget": true, "params": {} },
    { "name": "spin_wheels", "kind": "gesture", "bodies": ["vehicle"], "parts": ["wheel_*", "squash", "body", "exhaust", "chimney"], "seconds": { "min": 0.6, "default": 1.5, "max": 4 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "park", "kind": "gesture", "bodies": ["vehicle"], "parts": ["squash", "body", "head", "lid_L", "lid_R", "lamp_glow"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "start_up", "kind": "gesture", "bodies": ["vehicle"], "parts": ["squash", "body", "head", "lid_L", "lid_R", "lamp_glow", "chimney", "exhaust"], "seconds": { "min": 0.6, "default": 1.2, "max": 2.5 }, "overLine": false, "needsTarget": false, "params": {} },

    { "name": "react_surprised", "kind": "react", "bodies": ["creature", "vehicle"], "parts": ["squash", "root", "body", "head", "ear_L1", "ear_R1", "lid_L", "lid_R", "brow_L", "brow_R", "mouth", "wheel_*", "antenna*", "chimney", "exhaust"], "seconds": { "min": 0.6, "default": 1, "max": 2 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "laugh", "kind": "react", "bodies": ["creature", "vehicle"], "parts": ["body", "head", "squash", "lid_L", "lid_R", "mouth", "antenna*"], "seconds": { "min": 1, "default": 2, "max": 4 }, "overLine": false, "needsTarget": false, "params": {} },
    { "name": "droop", "kind": "react", "bodies": ["creature", "vehicle"], "parts": ["body", "head", "squash", "arm_L", "arm_R", "ear_L1", "ear_R1", "brow_L", "brow_R", "lid_L", "lid_R", "mouth", "antenna*"], "seconds": { "min": 0.8, "default": 1.6, "max": 4 }, "overLine": true, "needsTarget": false, "params": {} },

    { "name": "cut", "kind": "camera", "bodies": ["creature", "vehicle"], "parts": ["camera"], "seconds": { "min": 0.04, "default": 0.04, "max": 0.04 }, "overLine": true, "needsTarget": false, "params": {} },
    { "name": "pan", "kind": "camera", "bodies": ["creature", "vehicle"], "parts": ["camera"], "seconds": { "min": 0.5, "default": 1.2, "max": 4 }, "overLine": true, "needsTarget": false, "params": { "ease": "inOut" } },
    { "name": "push", "kind": "camera", "bodies": ["creature", "vehicle"], "parts": ["camera"], "seconds": { "min": 1, "default": 3, "max": 10 }, "overLine": true, "needsTarget": false, "params": { "to": "closer shot" } },
    { "name": "follow", "kind": "camera", "bodies": ["creature", "vehicle"], "parts": ["camera"], "seconds": { "min": 1, "default": 3, "max": 12 }, "overLine": true, "needsTarget": true, "params": {} },
    { "name": "shake_small", "kind": "camera", "bodies": ["creature", "vehicle"], "parts": ["camera"], "seconds": { "min": 0.2, "default": 0.5, "max": 1.5 }, "overLine": true, "needsTarget": false, "params": {} }
  ]
}
